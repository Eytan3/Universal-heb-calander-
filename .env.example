# --- Storage -----------------------------------------------------------------
# Local dev / self-hosting: events are stored in ./data/events.json by default.
# UC_DATA_FILE=/absolute/path/to/events.json

# Vercel (or anywhere): Upstash Redis REST credentials. Either naming works;
# Vercel's Upstash integration sets the KV_* names automatically.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UC_REDIS_KEY=universal-calendar:events:v1

# --- Optional shared secrets (strongly recommended on a public deployment) ----
# Writes require "Authorization: Bearer <UC_EDIT_TOKEN>"; the UI asks for it once.
# UC_EDIT_TOKEN=
# The ICS feed requires ?token=<UC_FEED_TOKEN>. Use a different value from UC_EDIT_TOKEN.
# UC_FEED_TOKEN=

# --- ICS feed ------------------------------------------------------------------
# UC_CALENDAR_NAME=Universal Calendar
# Part of every occurrence UID. Never change it after people have subscribed.
# UC_UID_DOMAIN=universal-calendar
# UC_TIMEZONE=UTC
# UC_FEED_PAST_DAYS=365
# UC_FEED_FUTURE_DAYS=1098
