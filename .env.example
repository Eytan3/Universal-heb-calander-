# --- Storage -----------------------------------------------------------------
# Local dev / self-hosting: events are stored in ./data/events.json by default.
# UC_DATA_FILE=/absolute/path/to/events.json

# Vercel (or anywhere): Upstash Redis REST credentials. Either naming works;
# Vercel's Upstash integration sets the KV_* names automatically.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UC_REDIS_KEY=universal-calendar:events:v1

# --- Owner login (recommended on a public deployment) --------------------------
# Set BOTH so that only you (signed in) can add, change or delete. Set them in your host's
# environment settings (Vercel → Settings → Environment Variables), never in code:
# they are not stored in the repository. Changing the password signs out every device.
# UC_USER=
# UC_PASSWORD=
# Who may view: "public" (default; anyone sees the calendar read-only) or "private" (login to view too).
# UC_VISIBILITY=public
# Optional extra secret mixed into session and feed keys:
# UC_SESSION_SECRET=

# --- Optional shared secrets (only when owner login is off) --------------------
# Writes require "Authorization: Bearer <UC_EDIT_TOKEN>"; the UI asks for it once.
# UC_EDIT_TOKEN=
# The ICS feed requires ?token=<UC_FEED_TOKEN>. Use a different value from UC_EDIT_TOKEN.
# With owner login on, a feed token is derived automatically (shown in Settings); set this
# only if you want the feed link to stay the same when you change the password.
# UC_FEED_TOKEN=

# --- ICS feed ------------------------------------------------------------------
# UC_CALENDAR_NAME=Ittim
# Part of every occurrence UID. Never change it after people have subscribed.
# UC_UID_DOMAIN=universal-calendar
# UC_TIMEZONE=UTC
# UC_FEED_PAST_DAYS=365
# UC_FEED_FUTURE_DAYS=1098
